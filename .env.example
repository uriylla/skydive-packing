# Postgres connection string. Local: `docker compose up -d`. Production: Neon/Supabase URL.
DATABASE_URL=postgres://packing:packing@localhost:5432/packing

# Time zone that defines a jornada's calendar date.
APP_TIMEZONE=Europe/Madrid

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Initial supervisor created by `pnpm db:seed`.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
