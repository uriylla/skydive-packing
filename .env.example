# Postgres connection string. Local: `docker compose up -d`. Production: Neon/Supabase URL.
DATABASE_URL=postgres://packing:packing@localhost:5433/packing

# Throwaway database for integration tests (`pnpm test`). Leave unset to skip them.
# Create it once: docker compose exec db createdb -U packing packing_test
DATABASE_URL_TEST=postgres://packing:packing@localhost:5433/packing_test

# Time zone that defines a jornada's calendar date.
APP_TIMEZONE=Europe/Madrid

# Secret used to sign session cookies. Required in production (32+ chars).
# Generate with: openssl rand -base64 32. In development a built-in fallback is used.
SESSION_SECRET=change-me

# Initial supervisor created by `pnpm db:seed`.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# Packers must enter a PIN after tapping their name (true/false). Default: false.
REQUIRE_PACKER_PIN=false

# Language for devices that haven't picked one and whose browser language isn't
# supported: es, en or ca. English if unset.
DEFAULT_LOCALE=es
